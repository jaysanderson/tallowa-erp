# Tallowa Components demo - server-side secrets. Copy to .env and fill in.
# The retrieval service token NEVER reaches the browser; every call is proxied.
ARAG_HOST=
KB_ID=
KB_TOKEN=
APP_SECRET=change-me-signing-secret

# ARAG Retrieval Agent (the Ops Assistant's orchestrator - ARAG plans and calls
# this app's own /mcp, not the other way around). Agent config lives on the
# data-platform host, NOT the KB host above.
ARAG_AGENT_KEY=
ARAG_AGENT_BASE_URL=https://aws-ap-southeast-2-1.dp.progress.cloud

# The agent IS a mode:"agent" Knowledge Box - its id doubles as the agent id.
ARAG_AGENT_KB_ID=
ARAG_AGENT_KB_TOKEN=
